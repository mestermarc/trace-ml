# TraceML dev container: Ubuntu 24.04 + Python 3.12 + uv + Node 22, run as a non-root user.
# Nothing here depends on the host: the user is a build arg, and the in-container paths below
# (workspace, caches) are defined once and used by .devcontainer/ and traceml.sh.
#
# Build (from the repo root):   podman build -t traceml-dev -f container/Containerfile .
# Or just use:                  container/traceml.sh build

ARG UV_VERSION=0.8.17

FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

FROM docker.io/library/ubuntu:24.04

ARG NODE_MAJOR=22
ARG USERNAME=dev
ARG USER_UID=1000
ARG USER_GID=1000

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    WORKSPACE=/workspace \
    UV_CACHE_DIR=/cache/uv \
    UV_PROJECT_ENVIRONMENT=/cache/venv \
    UV_LINK_MODE=copy \
    CLAUDE_CONFIG_DIR=/cache/claude

# System packages: Python, build basics, git, and Node from NodeSource (package.json needs node >=20).
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg git sudo less nano \
      python3 python3-venv python3-pip \
 && curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/*

# uv / uvx binaries, copied from Astral's official image (pinned by UV_VERSION).
COPY --from=uv /uv /uvx /usr/local/bin/

# Ubuntu 24.04 ships a default "ubuntu" user on UID 1000; remove it so ${USERNAME} can take that UID
# (UID 1000 matches the default user inside the Podman machine, so bind-mounted files line up).
RUN if id ubuntu >/dev/null 2>&1; then userdel -r ubuntu; fi \
 && groupadd --gid ${USER_GID} ${USERNAME} \
 && useradd --uid ${USER_UID} --gid ${USER_GID} --create-home --shell /bin/bash ${USERNAME}

# Passwordless sudo for any command (dev convenience: anything running as the user can act as root
# inside the container). Delete these lines to make the container strictly non-root.
RUN echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${USERNAME} \
 && chmod 0440 /etc/sudoers.d/${USERNAME}

# Mount targets, pre-created so named volumes are owned by the user rather than root. uv's cache
# and virtualenv live under /cache, out of the bind-mounted checkout.
RUN mkdir -p "${WORKSPACE}/node_modules" "${UV_CACHE_DIR}" "${UV_PROJECT_ENVIRONMENT}" "${CLAUDE_CONFIG_DIR}" \
 && chown -R ${USER_UID}:${USER_GID} "${WORKSPACE}" /cache

USER ${USERNAME}
WORKDIR ${WORKSPACE}
ENV PATH=/home/${USERNAME}/.local/bin:${PATH}

CMD ["bash", "-l"]
