{
  "name": "traceml",
  "displayName": "TraceML",
  "description": "Read-only, filesystem-only viewer for ML training runs (tables, plots, comparison) inside VS Code. Works over Remote-SSH.",
  "version": "0.2.1",
  "publisher": "mestermarc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mestermarc/trace-ml.git"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=20"
  },
  "categories": [
    "Visualization",
    "Data Science",
    "Machine Learning"
  ],
  "keywords": [
    "experiments",
    "ml",
    "training",
    "metrics",
    "runs"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onWebviewPanel:traceml.experiments",
    "onView:traceml.home"
  ],
  "contributes": {
    "commands": [
      {
        "command": "traceml.showExperiments",
        "title": "Show Experiments",
        "category": "TraceML",
        "icon": "$(graph)"
      },
      {
        "command": "traceml.refresh",
        "title": "Refresh",
        "category": "TraceML",
        "icon": "$(refresh)"
      },
      {
        "command": "traceml.revealRun",
        "title": "Show Run Details",
        "category": "TraceML"
      },
      {
        "command": "traceml.copyRunPath",
        "title": "Copy Run Folder Path",
        "category": "TraceML"
      },
      {
        "command": "traceml.openRunLog",
        "title": "Open Log (read-only)",
        "category": "TraceML"
      },
      {
        "command": "traceml.openRunMetrics",
        "title": "Open metrics.jsonl (read-only)",
        "category": "TraceML"
      }
    ],
    "configuration": {
      "title": "TraceML",
      "properties": {
        "traceml.roots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "./traceml/runs"
          ],
          "markdownDescription": "The runs folders TraceML reads. Each entry is a folder whose direct sub-folders are runs: a path relative to each workspace folder (default `./traceml/runs`; e.g. `./runs`, `outputs/runs`) or an absolute path (`/data/me/runs`, `D:\\\\runs`). Entries that don't exist are skipped. Nothing else is scanned, and TraceML never reads outside these folders."
        },
        "traceml.refreshIntervalSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "markdownDescription": "Polling interval in seconds."
        },
        "traceml.staleAfterSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "markdownDescription": "A `running` run whose `heartbeat_at` is older than this is shown as `stale`."
        },
        "traceml.maxPointsPerSeries": {
          "type": "integer",
          "default": 5000,
          "minimum": 100,
          "markdownDescription": "Series longer than this are downsampled with min/max-preserving buckets before plotting."
        },
        "traceml.maxMetricsFileMB": {
          "type": "number",
          "default": 64,
          "minimum": 1,
          "markdownDescription": "At most this many megabytes of each plotted run's `metrics.jsonl` are loaded into memory. Larger files are plotted partially with a warning."
        },
        "traceml.cacheDir": {
          "type": "string",
          "default": "./traceml/.cache",
          "markdownDescription": "Folder where TraceML keeps its own files: the remembered view (`ui-state.json`), the run database (`runs.sqlite`), runs deleted from TraceML (`hidden-runs.json`), CSV table exports (`exports/`) and plots / plot data (`plots/`). A path relative to the (first) workspace folder or an absolute path. This is the only place TraceML writes; run folders are never modified."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "traceml",
          "title": "TraceML",
          "icon": "media/curly_m.svg"
        }
      ]
    },
    "views": {
      "traceml": [
        {
          "id": "traceml.home",
          "name": "Experiments",
          "icon": "media/curly_m.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "traceml.home",
        "contents": "Browse the ML training runs of this workspace.\n[Open Experiments](command:traceml.showExperiments)\n[Refresh](command:traceml.refresh)\nRuns are read from ./traceml/runs by default. Change the folder with the [traceml.roots](command:workbench.action.openSettings?%5B%22traceml.roots%22%5D) setting."
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "traceml.refresh",
          "when": "view == traceml.home",
          "group": "navigation@1"
        },
        {
          "command": "traceml.showExperiments",
          "when": "view == traceml.home",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "traceml.copyRunPath",
          "when": "view == traceml.home && viewItem == traceml.run",
          "group": "1_copy@1"
        },
        {
          "command": "traceml.openRunLog",
          "when": "view == traceml.home && viewItem == traceml.run",
          "group": "2_open@1"
        },
        {
          "command": "traceml.openRunMetrics",
          "when": "view == traceml.home && viewItem == traceml.run",
          "group": "2_open@2"
        }
      ],
      "commandPalette": [
        {
          "command": "traceml.revealRun",
          "when": "false"
        },
        {
          "command": "traceml.copyRunPath",
          "when": "false"
        },
        {
          "command": "traceml.openRunLog",
          "when": "false"
        },
        {
          "command": "traceml.openRunMetrics",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:prod": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "package": "npm run typecheck && npm test && npm run build:prod && vsce package --no-dependencies",
    "preview": "esbuild scripts/preview.ts --bundle --platform=node --outfile=dist/preview.cjs --log-level=warning && node dist/preview.cjs",
    "bench": "esbuild scripts/bench.ts --bundle --platform=node --outfile=dist/bench.cjs --log-level=warning && node dist/bench.cjs",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "dependencies": {
    "sql.js": "^1.14.2",
    "uplot": "^1.6.31",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/sql.js": "^1.4.11",
    "@types/vscode": "~1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "icon": "media/extension_logo.png",
  "galleryBanner": {
    "color": "#13151a",
    "theme": "dark"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "bugs": {
    "url": "https://github.com/mestermarc/trace-ml/issues"
  },
  "homepage": "https://github.com/mestermarc/trace-ml#readme"
}
