{
  "name": "TraceML (Podman)",
  "build": {
    "dockerfile": "../container/Containerfile",
    "context": "..",
    "args": { "USERNAME": "dev" }
  },
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "remoteUser": "dev",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "mounts": [
    "source=traceml-node-modules,target=/workspace/node_modules,type=volume",
    "source=traceml-uv-cache,target=/cache/uv,type=volume",
    "source=traceml-claude-config,target=/cache/claude,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code"]
    }
  }
}
